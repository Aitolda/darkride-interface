<@include gpu/Config.slh@>
<$VERSION_HEADER$>
//  Generated on <$_SCRIBE_DATE$>
//
//  mirror_screen.slf
//  The glass of a screen-mode mirror (Mirrors.h): its picture was drawn from the viewer's reflection with the
//  main view's own projection, so it lies pixel for pixel under the glass; it is read by screen position, flipped
//  across (the reflected camera was turned into a proper one), and written unlit, as light of its own.
//
