/* Build mode: the panels docked around the viewport. A dark editor theme, close to the
   Unity dark skin, scoped by object name so nothing else in the window is restyled. */

#EditorHierarchy, #EditorInspector {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
#EditorHierarchy QWidget, #EditorInspector QWidget {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
QDockWidget#EditorHierarchy::title, QDockWidget#EditorInspector::title {
    background: #3c3c3c;
    color: #d2d2d2;
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid #232323;
}

/* search field */
#EditorHierarchy QLineEdit {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #2c5d87;
}
#EditorHierarchy QLineEdit:focus {
    border-color: #2c5d87;
}

/* the entity tree */
#EditorHierarchy QTreeView {
    background: #383838;
    border: none;
    outline: 0;
    show-decoration-selected: 1;
}
#EditorHierarchy QTreeView::item {
    height: 20px;
    padding-left: 2px;
}
#EditorHierarchy QTreeView::item:hover {
    background: #404040;
}
#EditorHierarchy QTreeView::item:selected {
    background: #2c5d87;
    color: #ffffff;
}
/* styling the branch area at all replaces Qt's expander arrows, so they are drawn here: a parent's children were
   there but unseen, with nothing to open them by. Only Qt's own pseudo-states may be named: an unknown one makes
   the rule match every branch cell, arrows on everything */
#EditorHierarchy QTreeView::branch {
    background: #383838;
}
#EditorHierarchy QTreeView::branch:selected {
    background: #2c5d87;
}
#EditorHierarchy QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(:/styles/branch-closed.svg);
}
#EditorHierarchy QTreeView::branch:has-children:open {
    border-image: none;
    image: url(:/styles/branch-open.svg);
}

/* inspector */
#EditorInspector QScrollArea {
    border: none;
}
#EditorInspector QLabel#EditorInspectorEmpty {
    color: #8f8f8f;
}
#EditorInspector QLabel#EditorInspectorTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 4px 2px 6px 2px;
}
#EditorInspector QToolButton#EditorInspectorHeader {
    background: #3c3c3c;
    color: #d2d2d2;
    font-weight: bold;
    text-align: left;
    border: none;
    border-top: 1px solid #2b2b2b;
    padding: 4px 6px;
}
#EditorInspector QToolButton#EditorInspectorHeader:hover {
    background: #454545;
}
#EditorInspector #EditorInspectorMinorSection QToolButton#EditorInspectorHeader {
    background: #383838;
    font-weight: normal;
    color: #b8b8b8;
    padding-left: 14px;
}
#EditorInspector QLabel#EditorInspectorLabel {
    color: #c4c4c4;
}
#EditorInspector QLabel#EditorComponentLabel {
    color: #9a9a9a;
    padding-right: 1px;
}
#EditorInspector QDoubleSpinBox, #EditorInspector QLineEdit, #EditorInspector QComboBox, #EditorInspector QPlainTextEdit {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 4px;
    selection-background-color: #2c5d87;
    min-height: 18px;
}
#EditorInspector QDoubleSpinBox:focus, #EditorInspector QLineEdit:focus, #EditorInspector QPlainTextEdit:focus {
    border-color: #2c5d87;
}
#EditorInspector QComboBox::drop-down {
    border: none;
    width: 16px;
}
#EditorInspector QComboBox QAbstractItemView {
    background: #2a2a2a;
    selection-background-color: #2c5d87;
}
#EditorInspector QToolButton {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 6px;
}
/* + Add opens a menu: its text says so, without Qt's arrow drawn over it */
#EditorInspector QToolButton#EditorUserDataAdd::menu-indicator {
    image: none;
    width: 0;
}
#EditorInspector QCheckBox {
    spacing: 6px;
}
/* a Range's slider, as Unity draws one: a thin groove and a small round handle */
#EditorInspector QSlider {
    min-height: 18px;
}
#EditorInspector QSlider::groove:horizontal {
    height: 3px;
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 2px;
}
#EditorInspector QSlider::handle:horizontal {
    background: #9a9a9a;
    border: 1px solid #1f1f1f;
    width: 10px;
    margin: -4px 0;
    border-radius: 6px;
}
#EditorInspector QSlider::handle:horizontal:hover {
    background: #c4c4c4;
}
#EditorInspector QSlider::handle:horizontal:disabled {
    background: #555555;
}
#EditorInspector QLabel#EditorInspectorNote {
    color: #8f8f8f;
}
#EditorInspector QLabel#EditorImageThumbnail {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    color: #8f8f8f;
}

/* User Data: its entries, folding as the Hierarchy's tree does */
#EditorInspector QTreeWidget#EditorUserData {
    background: #383838;
    border: 1px solid #2b2b2b;
    border-radius: 3px;
    outline: 0;
}
#EditorInspector QTreeWidget#EditorUserData::item {
    min-height: 24px;
    padding-left: 2px;
}
#EditorInspector QTreeWidget#EditorUserData::branch {
    background: #383838;
}
#EditorInspector QTreeWidget#EditorUserData::branch:has-children:closed {
    border-image: none;
    image: url(:/styles/branch-closed.svg);
}
#EditorInspector QTreeWidget#EditorUserData::branch:has-children:open {
    border-image: none;
    image: url(:/styles/branch-open.svg);
}

/* scroll bars */
#EditorHierarchy QScrollBar:vertical, #EditorInspector QScrollBar:vertical {
    background: #2f2f2f;
    width: 10px;
    margin: 0;
}
#EditorHierarchy QScrollBar::handle:vertical, #EditorInspector QScrollBar::handle:vertical {
    background: #5a5a5a;
    min-height: 24px;
    border-radius: 5px;
}
#EditorHierarchy QScrollBar::add-line:vertical, #EditorHierarchy QScrollBar::sub-line:vertical,
#EditorInspector QScrollBar::add-line:vertical, #EditorInspector QScrollBar::sub-line:vertical {
    height: 0;
}

/* the tool strip above the viewport */
QToolBar#EditorToolBar {
    background: #3c3c3c;
    border: none;
    border-bottom: 1px solid #232323;
    spacing: 2px;
    padding: 2px 6px;
}
QToolBar#EditorToolBar QToolButton {
    background: transparent;
    color: #d2d2d2;
    font-size: 12px;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 9px;
}
QToolBar#EditorToolBar QToolButton:hover {
    background: #474747;
}
QToolBar#EditorToolBar QToolButton:checked {
    background: #505050;
    border-color: #232323;
}
QToolBar#EditorToolBar QToolButton:pressed {
    background: #2c5d87;
}
QToolBar#EditorToolBar::separator {
    width: 1px;
    background: #232323;
    margin: 4px 6px;
}

/* the splitters between the panels and the viewport */
QMainWindow::separator {
    background: #232323;
    width: 2px;
    height: 2px;
}
QMainWindow::separator:hover {
    background: #2c5d87;
}

/* the Create button and the status note on the build toolbar */
QToolBar#EditorToolBar QToolButton::menu-indicator {
    image: none;
    width: 0;
}
QToolBar#EditorToolBar QLabel#EditorStatus {
    color: #9a9a9a;
    font-size: 12px;
    padding: 0 8px;
}

/* a button that cannot be used now (Save World before World Edit is on) */
QToolBar#EditorToolBar QToolButton:disabled {
    color: #6a6a6a;
}
/* World Edit while it is on: the world is being changed, which should be impossible to miss */
QToolBar#EditorToolBar QToolButton#EditorWorldEdit:checked {
    background: #c76a16;
    border-color: #7d430e;
    color: #ffffff;
}
QToolBar#EditorToolBar QToolButton#EditorWorldEdit:checked:hover {
    background: #d77b28;
}

/* read-only: a note at the top of both panels, dimmed names, greyed fields */
#EditorHierarchy QLabel#EditorReadOnlyBanner, #EditorInspector QLabel#EditorReadOnlyBanner {
    background: #4d3b1c;
    color: #f2dcae;
    padding: 5px 8px;
    border-bottom: 1px solid #232323;
}
#EditorHierarchy QTreeView[readOnly="true"] {
    color: #8a8a8a;
}
#EditorInspector QDoubleSpinBox:disabled, #EditorInspector QLineEdit:disabled, #EditorInspector QComboBox:disabled,
#EditorInspector QPlainTextEdit:disabled, #EditorInspector QToolButton:disabled {
    color: #7a7a7a;
    background: #323232;
}
#EditorInspector QCheckBox:disabled {
    color: #7a7a7a;
}
